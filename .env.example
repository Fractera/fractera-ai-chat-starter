# Fractera AI Chat — environment
#
# On a real deployment this file is written for you by the server's install script
# (`lib/bootstrap.sh` in the Easy Starter): the database, the secret and the paths below are
# generated when the server is born. What follows is the list of names, for local work and for
# reading — never commit real values.
#
# 🔒 Names the upstream template asks for and WE DO NOT USE — see SOURCE.md for the reasons:
#   AI_GATEWAY_API_KEY   the Vercel AI Gateway is not used; the project has one OpenAI key
#   BLOB_READ_WRITE_TOKEN  files go to the project's own media library, not to Vercel Blob
#   REDIS_URL            resumable streams are not set up yet

# Session secret, SHARED with the Fractera auth service — the chat reads the same cookie the
# panel and the site read, so the value must be identical across the server.
# `openssl rand -base64 32`
AUTH_SECRET=****

# The chat's own PostgreSQL database on this server. The build migrates it before compiling.
POSTGRES_URL=postgres://fractera_chat:****@127.0.0.1:5432/fractera_chat

# Port of the service. 3600 in a Fractera deployment; 3000 is taken by the guest app.
PORT=3600

# Fractera sign-in service. Two addresses on purpose, and mixing them up is the classic mistake:
#   AUTH_SERVICE_URL      how THIS SERVER reaches it (loopback, no TLS)
#   NEXT_PUBLIC_AUTH_URL  how a BROWSER reaches it — this one ends up in links people click
AUTH_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=https://auth.example.com

# The project's own environment file. The chat reads the OpenAI key and the data-layer address
# from it on every request instead of keeping its own copy: one key, one path, no drift.
FRACTERA_SLOT_ENV=/opt/fractera/app/.env.local

# Shown in the interface.
NEXT_PUBLIC_APP_NAME=Fractera
NEXT_PUBLIC_COMPANY_NAME=Fractera

# ── Channels: a message from Telegram becomes a message in this chat (step 97-2) ──
#
# The SAME secret is stored in the channel service's `config.json` on :3500, under
# `telegram.hookSecret`. One secret, two readers — never two values.
# An empty value CLOSES the door rather than opening it: a forgotten setting must not
# mean "accept everyone".
CHANNELS_HOOK_SECRET=****

# Who owns a conversation that arrives from a channel. Owner's decision 2026-09-03:
# it is the person who linked the bot — never a new "Telegram user" account, because the
# chat has no sign-in of its own (step 96) and a second source of truth about people is
# exactly what was removed with the guest provider.
# Empty falls back to the first account created, and the fallback is said out loud.
CHANNELS_OWNER_EMAIL=
